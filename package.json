{
  "name": "create-vben",
  "version": "1.0.0",
  "description": "CLI scaffold generator for vue-vben-admin — extract one UI template (Ant Design Vue, Element Plus, Naive UI, TDesign) into a standalone Vue 3 + Vite project.",
  "type": "module",
  "license": "MIT",
  "author": "379949990",
  "keywords": [
    "create-vben",
    "vben",
    "vben-admin",
    "vue-vben-admin",
    "vben-admin",
    "scaffold",
    "scaffolding",
    "cli",
    "generator",
    "monorepo",
    "vue3",
    "vue",
    "vite",
    "typescript",
    "admin",
    "dashboard",
    "naive-ui",
    "ant-design-vue",
    "element-plus",
    "tdesign",
    "pnpm"
  ],
  "bin": {
    "create-vben": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "postbuild": "node --input-type=module -e \"import fs from 'node:fs'; const c=fs.readFileSync('dist/index.js','utf8'); if (!c.startsWith('#!/usr/bin/env node\\\\n') || c.indexOf('#!/usr/bin/env node', 1) !== -1) { console.error('dist/index.js must have exactly one shebang on line 1'); process.exit(1); }\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "globby": "^14.1.0",
    "kolorist": "^1.8.0",
    "minimatch": "^10.0.1",
    "semver": "^7.7.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "typescript-eslint": "^8.26.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/379949990/create-vben"
  },
  "bugs": {
    "url": "https://github.com/379949990/create-vben/issues"
  },
  "homepage": "https://github.com/379949990/create-vben#readme"
}
